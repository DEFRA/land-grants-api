{
  "$schema": "node_modules/knip/schema.json",
  "ignoreBinaries": ["soffice", "gitleaks"],
  "ignoreIssues": {
    "**/tests/**": ["exports"],
    "**/fixtures/**": ["exports"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "src/index.js",
        "scripts/**/*.js",
        "src/tests/load-tests/*.js",
        "src/**/*.d.js",
        "src/tests/e2e-tests/setup/teardown.js",
        "vitest.db.teardown.js",
        "src/features/land-data-ingest/workers/ingest.worker.js"
      ],
      "ignoreDependencies": ["k6", "pino-pretty"]
    },
    "packages/rules-schemas": {
      "ignoreDependencies": ["joi"]
    }
  }
}
